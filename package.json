{
  "name": "@olegbalbekov/openclaw-max",
  "version": "0.7.1",
  "description": "MAX messenger (max.ru) channel plugin for OpenClaw",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src index.ts secret-contract-api.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run check:sdk-imports && npm run test:coverage && npm run check:test-isolation && npm run build && npm run check:pack",
    "check:pack": "npm pack --dry-run",
    "check:sdk-imports": "node scripts/check-sdk-imports.mjs",
    "check:test-isolation": "node scripts/check-test-isolation.mjs"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "devDependencies": {
    "openclaw": ">=2026.3.24",
    "typescript": "^5.9.3",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "max",
    "max.ru",
    "messenger",
    "chatbot",
    "channel"
  ],
  "author": "Oleg Balbekov <oleg@evrone.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olegbalbekov/openclaw-max.git"
  },
  "homepage": "https://github.com/olegbalbekov/openclaw-max",
  "bugs": {
    "url": "https://github.com/olegbalbekov/openclaw-max/issues"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "max",
      "label": "MAX",
      "selectionLabel": "MAX (Bot API)",
      "docsPath": "/channels/max",
      "docsLabel": "max",
      "blurb": "Connect OpenClaw to MAX messenger via Bot API. Supports DMs and group chats.",
      "order": 80
    },
    "install": {
      "npmSpec": "@olegbalbekov/openclaw-max",
      "localPath": "extensions/max",
      "defaultChoice": "npm"
    }
  },
  "dependencies": {
    "undici": "^7.24.4",
    "zod": "^4.3.6"
  }
}
